# React/Vite SPA Routing fuer Apache + LiteSpeed
DirectoryIndex index.html
Options +FollowSymLinks -Indexes -MultiViews

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # ----------------------------------------------------------
  # Canonical Host: Erzwinge https:// + www.
  # WICHTIG: Beide Regeln MUESSEN vor allen anderen RewriteRules
  # stehen und mit absoluter URL + [L,R=301] enden, damit LiteSpeed
  # sie sofort ausliefert. "RewriteRule ^" ohne Slash kann auf
  # manchen LiteSpeed-Setups stillschweigend ignoriert werden,
  # daher hier "RewriteRule (.*)" mit explizitem Capture.
  # ----------------------------------------------------------

  # 1) HTTP -> HTTPS (alle Hosts)
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule (.*) https://www.zoomlion-nrw.de/$1 [L,R=301,NE]

  # 2) non-www -> www (auch fuer https-Anfragen auf Apex-Domain)
  RewriteCond %{HTTP_HOST} ^zoomlion-nrw\.de$ [NC]
  RewriteRule (.*) https://www.zoomlion-nrw.de/$1 [L,R=301,NE]

  # 3) index.html nicht erneut umschreiben (Endlosschleife verhindern)
  RewriteRule ^index\.html$ - [L]

  # 4) Vorhandene Dateien/Ordner/Symlinks normal ausliefern
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d [OR]
  RewriteCond %{REQUEST_FILENAME} -l
  RewriteRule ^ - [L]

  # 5) Prerendered Routen: /bagger -> /bagger/index.html (etc.)
  RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
  RewriteRule ^([^/]+(?:/[^/]+)*)/?$ /$1/index.html [L]

  # 6) Restliche Deep-Links der SPA auf root index.html (Fallback)
  RewriteRule ^.*$ /index.html [L]
</IfModule>

# Fallback falls Rewrite-Regeln beim Host eingeschraenkt sind
ErrorDocument 404 /index.html

# ============================================================
# Caching-Strategie (Core Web Vitals optimiert)
# ============================================================

<IfModule mod_expires.c>
  ExpiresActive On
</IfModule>

<IfModule mod_headers.c>
  # ----------------------------------------------------------
  # 1) HTML (prerendered Routen + SPA-Fallback)
  # ----------------------------------------------------------
  <FilesMatch "\.(html)$">
    Header set Cache-Control "public, max-age=300, s-maxage=3600, stale-while-revalidate=86400"
    Header unset Pragma
    Header unset Expires
  </FilesMatch>

  # ----------------------------------------------------------
  # 2) Hashed Build-Assets
  # ----------------------------------------------------------
  <FilesMatch "\.(js|mjs|css|woff|woff2|ttf|otf|eot)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # ----------------------------------------------------------
  # 3) Bilder & PDFs
  # ----------------------------------------------------------
  <FilesMatch "\.(png|jpg|jpeg|webp|avif|gif|svg|ico|pdf)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # ----------------------------------------------------------
  # 4) Sitemap & robots.txt
  # ----------------------------------------------------------
  <FilesMatch "(sitemap\.xml|robots\.txt)$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>

  # Sicherheits-Header
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

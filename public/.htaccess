# React/Vite SPA Routing fuer Apache + LiteSpeed
DirectoryIndex index.html
Options -Indexes -MultiViews

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # index.html nicht erneut umschreiben
  RewriteRule ^index\.html$ - [L]

  # Vorhandene Dateien/Ordner/Symlinks normal ausliefern
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d [OR]
  RewriteCond %{REQUEST_FILENAME} -l
  RewriteRule ^ - [L]

  # Prerendered Routen: /bagger -> /bagger/index.html (etc.)
  # Pruefe explizit, ob ein gleichnamiges Verzeichnis mit index.html existiert
  RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
  RewriteRule ^([^/]+(?:/[^/]+)*)/?$ /$1/index.html [L]

  # Restliche Deep-Links der SPA auf root index.html (Fallback)
  RewriteRule ^.*$ /index.html [L]
</IfModule>

# Fallback falls Rewrite-Regeln beim Host eingeschraenkt sind
ErrorDocument 404 /index.html

# ============================================================
# Caching-Strategie (Core Web Vitals optimiert)
# ============================================================

<IfModule mod_expires.c>
  ExpiresActive On
</IfModule>

<IfModule mod_headers.c>
  # ----------------------------------------------------------
  # 1) HTML (prerendered Routen + SPA-Fallback)
  #    Kurzes Browser-Caching, langes CDN-Caching, SWR fuer
  #    sofortige Auslieferung waehrend Revalidate im Hintergrund.
  # ----------------------------------------------------------
  <FilesMatch "\.(html)$">
    Header set Cache-Control "public, max-age=300, s-maxage=3600, stale-while-revalidate=86400"
    Header unset Pragma
    Header unset Expires
  </FilesMatch>

  # ----------------------------------------------------------
  # 2) Hashed Build-Assets (Vite -> /assets/*-[hash].{js,css})
  #    Unveraenderlich, 1 Jahr cachen.
  # ----------------------------------------------------------
  <FilesMatch "\.(js|mjs|css|woff|woff2|ttf|otf|eot)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # ----------------------------------------------------------
  # 3) Bilder & PDFs (Produktbilder, OG-Image, Datenblaetter)
  #    Ebenfalls langlebig, immutable.
  # ----------------------------------------------------------
  <FilesMatch "\.(png|jpg|jpeg|webp|avif|gif|svg|ico|pdf)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # ----------------------------------------------------------
  # 4) Sitemap & robots.txt - moderates Caching
  # ----------------------------------------------------------
  <FilesMatch "(sitemap\.xml|robots\.txt)$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>

  # Sicherheits-Header (klein gehalten, SEO-neutral)
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
